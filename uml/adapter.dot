digraph Adapter {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.65", ranksep="0.65"];
  node [shape=record, fontname="DejaVu Sans", fontsize=10, style=rounded, color="#2D5873"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#607588"];
  client [label="{Main / GestorImpresiones|usa imprimir(...)}"];
  target [label="{«interface» Impresora|+ imprimir(documento: String): void}"];
  adapter [label="{AdaptadorImpresora|- antigua: ImpresoraAntigua|+ imprimir(documento: String): void}"];
  adaptee [label="{ImpresoraAntigua|+ imprimirTexto(texto: String): void}"];
  client -> target [label="usa"];
  adapter -> target [arrowhead=empty, style=dashed, label="implements"];
  adapter -> adaptee [label="delega"];
}
